{
  "manifest_version": 3,
  "name": "PilotHouse",
  "version": "0.6.1",
  "description": "Lets PilotHouse's agents use the tabs you put in the PilotHouse tab group, with your sign-ins, and lets you send pages, screenshots and elements to PilotHouse. Other tabs are read only when you ask.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications",
    "sidePanel",
    "storage",
    "offscreen",
    "tabCapture"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PilotHouse",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "send-to-pilothouse": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Send the selection, or the page, to PilotHouse"
    },
    "screenshot-area": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Screenshot an area for PilotHouse"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Pick an element for PilotHouse"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open the PilotHouse panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
