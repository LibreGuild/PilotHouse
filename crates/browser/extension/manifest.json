{
  "manifest_version": 3,
  "name": "PilotHouse",
  "version": "0.6.0",
  "description": "Lets PilotHouse's coding agents use tabs in the PilotHouse tab group of this Chrome, with your sign-ins. Nothing else.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "nativeMessaging", "tabs", "tabGroups"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Share this tab with PilotHouse",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
